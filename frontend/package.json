    "date-fns": "^2.30.0",
    "clsx": "^1.2.0",
    "tailwind-merge": "^1.13.0",
    "react-markdown": "^8.0.0",
    "remark-gfm": "^3.0.0",
    "react-syntax-highlighter": "^15.5.0",
    "react-dropzone": "^14.2.0",
    "react-webcam": "^7.0.0",
    "react-qr-scanner": "^1.0.0-alpha.11",
    "socket.io-client": "^4.6.0",
